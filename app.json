{
  "expo": {
    "name": "BCard",
    "slug": "BCard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/bcard_logo.png",
    "scheme": "bcard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon/Assets/bcard_logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1528",
        "foregroundImage": "./assets/expo.icon/Assets/bcard_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1528",
          "android": {
            "image": "./assets/expo.icon/Assets/bcard_logo.png",
            "imageWidth": 150
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs photo library access to upload your business card avatar and company logo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}